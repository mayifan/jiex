# DeepSeek API key, keep it only on server side.
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional, defaults to deepseek-chat
DEEPSEEK_MODEL=deepseek-chat

# GLM-OCR (BigModel) API key
GLM_OCR_API_KEY=your_api_key
# Optional, defaults to https://open.bigmodel.cn
GLM_OCR_BASE_URL=https://open.bigmodel.cn
# Optional, defaults to glm-ocr
GLM_OCR_MODEL=glm-ocr
# Optional, override full API URL (e.g. https://open.bigmodel.cn/api/paas/v4/layout_parsing)
GLM_OCR_API_URL=

# Optional server port in production mode
PORT=8080
